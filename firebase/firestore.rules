rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Published content is readable by the app; only admins can create or edit it.
    match /content/{document=**} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // A user can only access their own progress and favorites.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Deny everything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
