rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true
        || request.auth.token.email == 'mgedh.9ali@gmail.com');
    }

    function appChecked() {
      return request.app != null;
    }

    match /content/azkar/items/{itemId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /content/categories/{categoryId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && appChecked();
    }

    match /users/{uid}/progress/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid && appChecked();
    }

    match /users/{uid}/feedback/{feedbackId} {
      allow read: if signedIn() && request.auth.uid == uid && appChecked();
      allow create: if signedIn() && request.auth.uid == uid && appChecked()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == uid && appChecked()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (signedIn() && appChecked() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && appChecked() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && appChecked() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
      match /timeline/{eventId} {
        allow read: if isAdmin() || (signedIn() && appChecked() && get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid);
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid && appChecked();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /admin_jobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
