rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validProgress(date) {
      let d = request.resource.data;
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['date', 'completedSabah', 'completedMasaa', 'completedSleep', 'totalTasbeeh'])
        && d.date == date
        && d.completedSabah is bool
        && d.completedMasaa is bool
        && (!('completedSleep' in d) || d.completedSleep is bool)
        && d.totalTasbeeh is int
        && d.totalTasbeeh >= 0
        && d.totalTasbeeh < 1000000;
    }

    function validFeedbackCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['userId', 'type', 'message', 'status'])
        && d.userId == request.auth.uid
        && d.type in ['bug', 'feature', 'content', 'other']
        && d.message is string
        && d.message.size() > 0
        && d.message.size() < 2000
        && d.status == 'open';
    }

    function userFeedbackUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['replyUnread', 'updatedAt']);
    }

    function adminFeedbackUpdate() {
      return true;
    }

    function validZekr() {
      let d = request.resource.data;
      return d.keys().hasAll(['text', 'category', 'published'])
        && d.text is string
        && d.text.size() > 0
        && d.category is string;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fcmTokens', 'updatedAt', 'notificationsEnabled', 'notificationAudience', 'displayName', 'email']);
      allow delete: if isOwner(userId) || isAdmin();

      match /progress/{date} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validProgress(date);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /content/azkar {
      allow read: if true;
      allow write: if isAdmin();

      match /items/{itemId} {
        allow read: if isAdmin() || resource.data.published == true;
        allow create, update: if isAdmin() && validZekr();
        allow delete: if isAdmin();
      }
    }

    match /content/categories/{categoryId} {
      allow read: if isAdmin() || resource.data.get('published', true) == true;
      allow create, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() && validFeedbackCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if (isAdmin() && adminFeedbackUpdate())
        || (signedIn() && resource.data.userId == request.auth.uid && userFeedbackUpdate());
      allow delete: if isAdmin();

      match /timeline/{eventId} {
        allow read: if isAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid);
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'body', 'status'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() < 500
        && request.resource.data.status == 'queued';
      allow update, delete: if false;
    }

    match /admin_jobs/{jobId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['type', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['fcm_broadcast', 'feedback_reply', 'broadcast'];
      allow update, delete: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
