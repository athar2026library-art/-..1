rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Keep custom claims and the server-managed admins collection in sync.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin']
        )
      );
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.super_admin == true
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'super_admin'
        )
      );
    }

    function noPrivilegeKeys(data) {
      return !data.keys().hasAny(['role', 'admin', 'isAdmin', 'permissions', 'super_admin']);
    }

    function validAudioUrl(url) {
      return url is string
        && url.size() < 2048
        && (url == '' || url.matches('^https://.*'));
    }

    function validReciterAudio(data) {
      let audio = data.get('audioUrlsByReciter', {});
      return audio is map
        && audio.keys().hasOnly(['mishary', 'abdulbasit', 'maher', 'yasser'])
        && (!audio.keys().hasAny(['mishary']) || validAudioUrl(audio.mishary))
        && (!audio.keys().hasAny(['abdulbasit']) || validAudioUrl(audio.abdulbasit))
        && (!audio.keys().hasAny(['maher']) || validAudioUrl(audio.maher))
        && (!audio.keys().hasAny(['yasser']) || validAudioUrl(audio.yasser));
    }

    function validCategory(categoryId) {
      let d = request.resource.data;
      return categoryId.matches('^[a-z0-9_-]{2,30}$')
        && !categoryId.matches('^wird_.*')
        && !(categoryId in ['sabah', 'masaa', 'sleep', 'travel', 'worry', 'rizq', 'illness', 'waking', 'favorites'])
        && d.keys().hasOnly(['title', 'subtitle', 'icon', 'order', 'published', 'createdAt', 'updatedAt'])
        && d.title is string
        && d.title.size() > 0
        && d.title.size() <= 40
        && d.get('subtitle', '') is string
        && d.get('subtitle', '').size() <= 80
        && d.get('icon', 'star') in ['sun', 'moon', 'bed', 'car', 'heart', 'book', 'star', 'home', 'food', 'rain', 'shield', 'mosque']
        && (d.get('order', 0) is int || d.get('order', 0) is float)
        && d.get('published', true) is bool;
    }

    function validZekr() {
      let d = request.resource.data;
      return d.keys().hasAll(['text', 'category'])
        && d.text is string
        && d.text.size() > 0
        && d.text.size() < 4000
        && (d.category in ['sabah', 'masaa', 'sleep', 'travel', 'worry', 'rizq', 'illness', 'waking']
          || (d.category is string
              && exists(/databases/$(database)/documents/content/categories/items/$(d.category))))
        && (d.get('repeat', 1) is int || d.get('repeat', 1) is float)
        && d.get('repeat', 1) >= 1
        && d.get('repeat', 1) <= 1000
        && d.get('published', false) is bool
        && d.get('fadl', '') is string
        && d.get('source', '') is string
        && d.get('fadl', '').size() < 4000
        && d.get('source', '').size() < 500
        && validAudioUrl(d.get('audioUrl', ''))
        && validReciterAudio(d);
    }

    function validFeedbackCreate() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.keys().hasOnly(['userId', 'message', 'title', 'type', 'status', 'adminReply', 'replyUnread', 'createdAt', 'updatedAt', 'attachmentUrl', 'priority'])
        && d.message is string
        && d.message.size() > 0
        && d.message.size() <= 1000
        && d.get('title', '') is string
        && d.get('title', '').size() < 200
        && d.get('type', 'suggestion') in ['suggestion', 'complaint', 'technical', 'bug', 'other', 'feature', 'content']
        && d.get('status', 'new') in ['new', 'open']
        && d.get('adminReply', '') == ''
        && d.get('replyUnread', false) == false
        && noPrivilegeKeys(d);
    }

    function userFeedbackUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['replyUnread', 'updatedAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.replyUnread is bool;
    }

    function adminFeedbackUpdate() {
      let d = request.resource.data;
      return d.userId == resource.data.userId
        && d.diff(resource.data).affectedKeys()
          .hasOnly(['adminReply', 'status', 'replyUnread', 'updatedAt', 'priority', 'aiSummary', 'aiCategory'])
        && (!d.keys().hasAny(['adminReply']) || d.adminReply is string)
        && (!d.keys().hasAny(['status']) || d.status in ['new', 'open', 'replied', 'closed', 'in_progress'])
        && (!d.keys().hasAny(['replyUnread']) || d.replyUnread is bool);
    }

    function validProgress(date) {
      let d = request.resource.data;
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['date', 'completedSabah', 'completedMasaa', 'completedSleep', 'totalTasbeeh'])
        && d.date == date
        && d.completedSabah is bool
        && d.completedMasaa is bool
        && (!d.keys().hasAny(['completedSleep']) || d.completedSleep is bool)
        && d.totalTasbeeh is int
        && d.totalTasbeeh >= 0
        && d.totalTasbeeh < 1000000;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow create, update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && noPrivilegeKeys(request.resource.data)
        && request.resource.data.keys().size() < 30;
      allow update: if isOwner(userId)
        && noPrivilegeKeys(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fcmTokens', 'updatedAt', 'notificationsEnabled', 'notificationAudience', 'displayName', 'email']);
      allow update: if isOwner(userId)
        && (!request.resource.data.keys().hasAny(['fcmTokens'])
          || (request.resource.data.fcmTokens is list && request.resource.data.fcmTokens.size() <= 5));
      allow delete: if isOwner(userId);

      match /progress/{date} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validProgress(date);
        allow delete: if isOwner(userId);
      }

      match /feedback/{feedbackId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && validFeedbackCreate();
        allow update: if (isOwner(userId) && userFeedbackUpdate())
          || (isAdmin() && adminFeedbackUpdate());
        allow delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    match /content/azkar {
      allow read: if true;
      allow write: if isAdmin();

      match /items/{itemId} {
        allow read: if isAdmin() || resource.data.published == true;
        allow create, update: if isAdmin() && validZekr();
        allow delete: if isAdmin();
      }
    }

    match /content/categories {
      allow read: if true;

      match /items/{categoryId} {
        allow read: if isAdmin() || resource.data.get('published', true) == true;
        allow create, update: if isAdmin() && validCategory(categoryId);
        allow delete: if isAdmin();
      }
    }

    match /content/categories/{categoryId} {
      allow read: if isAdmin() || resource.data.get('published', true) == true;
      allow create, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() && validFeedbackCreate();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if (isAdmin() && adminFeedbackUpdate())
        || (signedIn() && resource.data.userId == request.auth.uid && userFeedbackUpdate());
      allow delete: if isAdmin();

      match /timeline/{eventId} {
        allow read: if isAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid);
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'body', 'status'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() < 500
        && request.resource.data.status == 'queued';
      allow update, delete: if false;
    }

    match /admin_jobs/{jobId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['type', 'status'])
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['fcm_broadcast', 'feedback_reply', 'broadcast'];
      allow update, delete: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
