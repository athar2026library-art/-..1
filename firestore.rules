rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'super_admin'
        )
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function noPrivilegeKeys(data) {
      return !data.keys().hasAny(['role', 'admin', 'isAdmin', 'permissions', 'super_admin']);
    }

    function validProgress(date) {
      let d = request.resource.data;
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['date', 'completedSabah', 'completedMasaa', 'totalTasbeeh'])
        && d.date == date
        && d.completedSabah is bool
        && d.completedMasaa is bool
        && d.totalTasbeeh is int
        && d.totalTasbeeh >= 0
        && d.totalTasbeeh < 1000000;
    }

    match /admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow create, update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && noPrivilegeKeys(request.resource.data)
        && request.resource.data.keys().size() < 30;
      allow delete: if isOwner(userId);

      match /progress/{date} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validProgress(date);
        allow delete: if isOwner(userId);
      }

      match /feedback/{feedbackId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /content/azkar {
      allow read: if true;
      allow write: if isAdmin();
      match /items/{itemId} {
        allow read: if isAdmin() || resource.data.published == true;
        allow write: if isAdmin();
      }
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
