rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isAdmin() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // RBAC: only existing admins may manage the admins collection
    match /admins/{adminId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == adminId);
      allow create, update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['role', 'admin', 'isAdmin', 'permissions']);
      allow delete: if signedIn() && request.auth.uid == userId;

      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
        allow read: if isAdmin();
      }
    }

    match /content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'message']);

      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);

      allow update: if isAdmin() ||
        (signedIn() &&
         resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['replyUnread', 'updatedAt']));

      allow delete: if isAdmin();
    }

    match /admin_jobs/{jobId} {
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['type', 'status']);
      allow read, update, delete: if isAdmin();
    }

    match /system/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
