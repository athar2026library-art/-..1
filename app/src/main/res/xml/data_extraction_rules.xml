<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- التقدم يُستعاد عبر Firebase Sync — استبعد قاعدة Room من النسخ السحابي -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
