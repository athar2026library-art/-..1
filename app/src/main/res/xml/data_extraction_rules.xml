<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- التقدم يُستعاد عبر Firebase Sync — استبعد قاعدة Room من النسخ السحابي -->
        <exclude domain="database" path="." />
        <!-- لا تنقل بيانات الحساب المحلي إلى النسخ السحابي -->
        <exclude domain="sharedpref" path="local_account.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <!-- الحساب المحلي مرتبط بهذا الجهاز فقط -->
        <exclude domain="sharedpref" path="local_account.xml" />
    </device-transfer>
</data-extraction-rules>
